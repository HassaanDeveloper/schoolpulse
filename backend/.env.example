APP_NAME=SchoolPulse API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000

# Supabase Auth - backend only.
# SUPABASE_JWT_SECRET is the project JWT secret used to verify access tokens.
# SUPABASE_SERVICE_ROLE_KEY must never be used for ordinary user authorization.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated