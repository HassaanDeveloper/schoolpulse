# Day 7: SchoolPulse Flutter configuration (fictional example).
#
# Values are compiled into the app via --dart-define. Nothing here is a
# secret: the Supabase URL and the anon key are public by design and are
# protected by Supabase row-level security. The backend JWT secret and the
# database URL must NEVER be passed to the app.
#
# Copy to .env.local (git-ignored) or pass the values inline on the build
# command line.

# HTTPS base URL of the deployed FastAPI backend. Must be https:// for a
# release build: Android refuses cleartext HTTP in release mode.
API_BASE_URL=https://api.example.com

# Supabase public project configuration.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY